# DrPanda MCP 环境变量示例（默认全部注释，本地零配置即可启动）
#
# 启动时会自动加载当前工作目录的 ./.env；不存在则使用环境变量与默认值。
#
# 本地默认：
#   uv run dr-panda-mcp      # 127.0.0.1:8111、SQLite、自动生成 data/secret.key
#
# 需要覆盖默认值时：
#   cp .env.example .env
#   取消对应行的注释并改值（.env 已被 .gitignore 忽略，不要提交；建议 chmod 600）
#   uv run dr-panda-mcp
#
# 优先级：真实环境变量 > .env > 代码默认值。
# 只认当前目录；权限过宽、不是普通文件、行格式非法时会启动失败（没有禁用开关）。
# systemd/Docker 注入的真实环境变量优先，不挂载 .env 也可以。
#
# 修改监听地址、端口、公网地址等启动参数后，必须重启进程才生效（不能在页面热改）。

# ---------------------------------------------------------------------------
# 远程 / 内网访问（仅本机使用不需要）
# ---------------------------------------------------------------------------
# 默认 127.0.0.1 只允许本机访问。服务器或团队内网改为 0.0.0.0（或指定网卡 IP）即对外监听；
# 首次安装仍需先在本机 loopback 完成，再切换远程监听并重启。
# 建议通过 HTTPS 反向代理访问；非 loopback 启动会输出警告日志。
# DR_PANDA_HOST="0.0.0.0"

# 展示地址（可选）：只用于页面和“复制 MCP 地址”，不参与 Cookie、Host 校验等安全判断。
# DR_PANDA_PUBLIC_URL="https://mcp.example.com"

# ---------------------------------------------------------------------------
# 可选覆盖（不设置时使用默认值，本地使用无需配置）
# ---------------------------------------------------------------------------
# 网页与 /mcp 共用端口（1–65535）。避开浏览器禁用端口（如 6665–6669），<1024 通常需要特权。
# DR_PANDA_PORT="8111"

# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
# DR_PANDA_LOG_LEVEL="INFO"

# Cookie Secure 策略：auto（按请求 scheme，默认）/ always / never。
# 通过 HTTPS 反向代理访问时建议 auto；跨机反代需要配置 uvicorn 的 FORWARDED_ALLOW_IPS。
# DR_PANDA_COOKIE_SECURE="auto"

# /mcp 的 Host 白名单（逗号分隔）；不设置时按 FastMCP 默认策略
# （loopback 绑定自动保护，0.0.0.0 绑定时不启用显式白名单）。
# DR_PANDA_TRUSTED_HOSTS="mcp.example.com"

# 加密密钥：base64 编码的 32 字节；不设置时自动生成 data/secret.key。
# 容器或 data/ 不持久化的部署必须显式设置，否则重建后已保存目标的密钥无法解密；
# 请与配置库一起备份。
# 生成命令：python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# DR_PANDA_SECRET_KEY=""

# ---------------------------------------------------------------------------
# 关于配置库
# ---------------------------------------------------------------------------
# 配置库由首次安装向导选择（SQLite / MySQL / PostgreSQL），之后以 data/install.json 为准。
